# Copy to .env (make env does this and fills CHANGEME with random values).
# Never commit .env. Secrets come from the environment or a secret store.

# Agency database (Postgres 16)
POSTGRES_USER=agency
POSTGRES_PASSWORD=CHANGEME_PG
POSTGRES_DB=agency
POSTGRES_PORT=5442
DATABASE_URL=postgresql+psycopg://agency:CHANGEME_PG@localhost:5442/agency

# LLM providers (referenced by name from config/agency.yaml)
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Per-project workspaces root (default: ./workspaces)
# AGENCY_WORKSPACES_DIR=

# Integrations (placeholders until M4 / M1)
JIRA_API_TOKEN=
GITHUB_TOKEN=

# Langfuse (self-hosted, `make up-tracing`)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_INIT_USER_EMAIL=owner@agency.local
LANGFUSE_INIT_USER_PASSWORD=CHANGEME
LANGFUSE_DB_PASSWORD=CHANGEME
LANGFUSE_NEXTAUTH_SECRET=CHANGEME
LANGFUSE_SALT=CHANGEME
LANGFUSE_ENCRYPTION_KEY=CHANGEME_KEY32
LANGFUSE_CLICKHOUSE_PASSWORD=CHANGEME
LANGFUSE_REDIS_AUTH=CHANGEME
LANGFUSE_MINIO_PASSWORD=CHANGEME
